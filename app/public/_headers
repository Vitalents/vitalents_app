/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://ask.vitalents.life http://localhost:8008 http://127.0.0.1:8008; worker-src 'self'; manifest-src 'self'

# The service worker must be re-checked on every visit so a new version is found.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json

# Built files carry a content hash in their name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
